{
  "name": "@entrolytics/redis-client",
  "version": "3.0.1",
  "description": "Redis client for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "cache",
    "entrolytics",
    "rate-limiting",
    "redis"
  ],
  "homepage": "https://github.com/entrolytics/redis-client",
  "bugs": {
    "url": "https://github.com/entrolytics/redis-client/issues"
  },
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrolytics/redis-client.git",
    "directory": "redis-client"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "oxlint --fix . && oxfmt --write .",
    "dev": "tsdown --watch",
    "format": "oxfmt --write .",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix-unsafe": "oxlint -f stylish --import-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tsdown": "^0.23.5",
    "typescript": "next",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "packageManager": "pnpm@12.17.0"
}
